{
  "compilerOptions": {
    "target": "ES2017",
    "module": "es2015",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "rootDir": "..",
    "outDir": "i18n-check"
  },
  "files": ["../web/i18n.ts", "i18n.test.ts"]
}
