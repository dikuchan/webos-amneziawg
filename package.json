{
  "name": "webos-amneziawg",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build:ui": "bun scripts/build-web.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun --no-env-file test web",
    "test:web": "playwright test",
    "preview": "bun scripts/preview.ts"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.9",
    "@webos-tools/cli": "3.2.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.8.3",
    "prettier-plugin-go-template": "0.0.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "overrides": {
    "fstream": {
      "mkdirp": "0.5.6"
    }
  }
}
